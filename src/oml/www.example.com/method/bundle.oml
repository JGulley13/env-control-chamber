@dc:title "Sierra bundle"
@dc:description "A packaging bundle that includes all Sierra vocabularies for operational analysis."
vocabulary bundle <http://www.example.com/method/bundle#> as v-bundle {
    includes <http://purl.org/dc/elements/1.1/> as dc
    includes <http://www.example.com/method/base#>
    includes <http://www.example.com/method/environment#>
    includes <http://www.example.com/method/mission#>
    includes <http://www.example.com/method/entity#>
    includes <http://www.example.com/method/process#>
    includes <http://www.example.com/method/stakeholder#>
    includes <http://www.example.com/method/scenario#>
    includes <http://www.example.com/method/state#>
}
