@dc:title "System Components"
@dc:description "Description of components for the Environmental Control Chamber system."
description <http://www.example.com/ec-chamber/system-analysis/components#> as components {
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <https://www.modelware.io/sierra/base#> as base
    uses <https://www.modelware.io/sierra/component#> as component
    uses <http://www.w3.org/2000/01/rdf-schema#> as rdfs

    @rdfs:label "Environmental Control Chamber"
    instance EnvironmentalChamber : component:Component [
        base:description "Primary chamber enclosure for environmental control during 3D printing."
    ]

    @rdfs:label "Chamber Shell"
    instance ChamberShell : component:Component [
        base:description "Insulated enclosure shell and structural body of the chamber."
        base:isContainedBy EnvironmentalChamber
    ]

    @rdfs:label "Print Zone"
    instance PrintZone : component:Component [
        base:description "Build volume where the 3D printer and processed parts are located."
        base:isContainedBy EnvironmentalChamber
    ]

    @rdfs:label "Air Handling Unit"
    instance AirHandlingUnit : component:Component [
        base:description "Air circulation and environmental conditioning subsystem."
        base:isContainedBy EnvironmentalChamber
    ]

    @rdfs:label "Intake Fan"
    instance IntakeFan : component:Component [
        base:description "Fan that pulls air through the chamber recirculation loop."
        base:isContainedBy AirHandlingUnit
    ]

    @rdfs:label "Exhaust Fan"
    instance ExhaustFan : component:Component [
        base:description "Fan that expels or refreshes chamber air."
        base:isContainedBy AirHandlingUnit
    ]

    @rdfs:label "Heater Bank"
    instance HeaterBank : component:Component [
        base:description "Heating elements used to increase chamber temperature."
        base:isContainedBy AirHandlingUnit
    ]

    @rdfs:label "Dehumidifier"
    instance Dehumidifier : component:Component [
        base:description "Device for reducing relative humidity within the chamber."
        base:isContainedBy AirHandlingUnit
    ]

    @rdfs:label "HEPA Filter"
    instance HEPAFilter : component:Component [
        base:description "High efficiency particulate filter for chamber air purification."
        base:isContainedBy AirHandlingUnit
    ]

    @rdfs:label "Carbon Filter"
    instance CarbonFilter : component:Component [
        base:description "Activated carbon filter for odor and chemical mitigation."
        base:isContainedBy AirHandlingUnit
    ]

    @rdfs:label "Temperature Sensor"
    instance TemperatureSensor : component:Component [
        base:description "Sensor that measures chamber temperature."
        base:isContainedBy EnvironmentalChamber
    ]

    @rdfs:label "Humidity Sensor"
    instance HumiditySensor : component:Component [
        base:description "Sensor that measures chamber relative humidity."
        base:isContainedBy EnvironmentalChamber
    ]

    @rdfs:label "Air Quality Sensor"
    instance AirQualitySensor : component:Component [
        base:description "Sensor that measures particulate and contamination levels."
        base:isContainedBy EnvironmentalChamber
    ]

    @rdfs:label "Controller"
    instance Controller : component:Component [
        base:description "Controller for closed-loop environmental regulation."
        base:isContainedBy EnvironmentalChamber
    ]

    @rdfs:label "User Interface"
    instance UserInterface : component:Component [
        base:description "Control panel for monitoring setpoints, conditions, and alarms."
        base:isContainedBy EnvironmentalChamber
    ]

    @rdfs:label "Safety Interlock"
    instance SafetyInterlock : component:Component [
        base:description "Safety system that disables or shuts down the enclosure when limits are violated."
        base:isContainedBy EnvironmentalChamber
    ]

    @rdfs:label "Power Supply"
    instance PowerSupply : component:Component [
        base:description "Power distribution and conditioning unit for the chamber."
        base:isContainedBy EnvironmentalChamber
    ]
}
