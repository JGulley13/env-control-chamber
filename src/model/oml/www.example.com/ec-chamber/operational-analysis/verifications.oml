@dc:title "Verification Description"
@dc:description "Description of verification activities for the Environmental Control Chamber"
description <http://www.example.com/ec-chamber/operational-analysis/verifications#> as verifications {
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <https://www.modelware.io/sierra/base#> as base
    uses <https://www.modelware.io/sierra/verification#> as verification
    extends <http://www.example.com/ec-chamber/operational-analysis/requirements#> as requirements
    extends <http://www.example.com/ec-chamber/system-analysis/components#> as components

    instance VC1 : verification:VerificationCase [
        base:description "Verify temperature control functionality"
        base:expression "The chamber maintains the print zone within the configured temperature range during operation."
        verification:verifies requirements:R1
        verification:status "In Progress"
        verification:method "Test"
        verification:hasEvidence components:TemperatureSensor
    ]

    instance VC2 : verification:VerificationCase [
        base:description "Verify humidity control"
        base:expression "During operation, measured chamber humidity remains within the configured operating range."
        verification:verifies requirements:R2
        verification:status "Passed"
        verification:method "Test"
        verification:hasEvidence components:HumiditySensor
    ]

    instance VC3 : verification:VerificationCase [
        base:description "Verify air quality monitoring"
        base:expression "The air quality sensor detects a condition beyond the configured limit and the system reports an alert."
        verification:verifies requirements:R3
        verification:status "Not Started"
        verification:method "Test"
        verification:hasEvidence components:AirQualitySensor
    ]

    instance VC4 : verification:VerificationCase [
        base:description "Verify alarm response"
        base:expression "When an environmental limit is exceeded, the system activates a visible or audible alarm."
        verification:verifies requirements:R4
        verification:status "Not Started"
        verification:method "Demonstration"
    ]

    instance VC5 : verification:VerificationCase [
        base:description "Verify air filtration"
        base:expression "Air passes through the filtration system, and inspection confirms the filter is installed in the exhaust path."
        verification:verifies requirements:R5
        verification:status "Passed"
        verification:method "Inspection"
        verification:hasEvidence components:HEPAFilter
    ]
}
