@dc:title "Requirements Description"
@dc:description "Description of requirements for the Environmental Control Chamber system."
description <http://www.example.com/ec-chamber/operational-analysis/requirements#> as requirements {
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <https://www.modelware.io/sierra/base#> as base
    uses <https://www.modelware.io/sierra/stakeholder#> as stakeholder
    extends <http://www.example.com/ec-chamber/context-analysis/stakeholders#> as stakeholders

    instance R1 : stakeholder:Requirement [
        base:description "Temperature control"
        base:expression "The chamber shall maintain the print zone within the configured temperature range during operation."
        stakeholder:isStatedBy stakeholders:SystemsEngineer
        base:category "L1"
        base:priority "High"
    ]

    instance R2 : stakeholder:Requirement [
        base:description "Humidity control"
        base:expression "The chamber shall maintain humidity within the configured operating range to protect the print process."
        stakeholder:isStatedBy stakeholders:ControlsEngineer
        base:category "L1"
        base:priority "High"
    ]

    instance R3 : stakeholder:Requirement [
        base:description "Air quality monitoring"
        base:expression "The chamber shall monitor particulate, VOC, and contamination levels and alert when limits are exceeded."
        stakeholder:isStatedBy stakeholders:SafetyEngineer
        base:category "L1"
        base:priority "High"
    ]

    instance R4 : stakeholder:Requirement [
        base:description "Alarm response"
        base:expression "The chamber shall trigger a visible or audible alarm when environmental limits are exceeded."
        stakeholder:isStatedBy stakeholders:SafetyEngineer
        base:category "L1"
        base:priority "High"
    ]

    instance R5 : stakeholder:Requirement [
        base:description "Air filtration"
        base:expression "The chamber shall filter and refresh air to maintain acceptable particulate and contaminant levels."
        stakeholder:isStatedBy stakeholders:MechanicalEngineer
        base:category "L2"
        base:priority "Medium"
    ]

    instance R6 : stakeholder:Requirement [
        base:description "Operator visibility"
        base:expression "The system shall provide a clear display of chamber state, setpoints, and live environmental conditions to the user."
        stakeholder:isStatedBy stakeholders:User
        base:category "L1"
        base:priority "Medium"
    ]

    instance R7 : stakeholder:Requirement [
        base:description "Fault handling"
        base:expression "The chamber shall transition to a safe state when a sensor fails or an environmental limit is violated."
        stakeholder:isStatedBy stakeholders:SystemsEngineer
        base:category "L2"
        base:priority "High"
    ]

    instance R8 : stakeholder:Requirement [
        base:description "Power stability"
        base:expression "The chamber shall continue safe operation during expected power fluctuations and maintain critical safety functions."
        stakeholder:isStatedBy stakeholders:ElectricalEngineer
        base:category "L1"
        base:priority "High"
    ]

    instance R9 : stakeholder:Requirement [
        base:description "Calibration and maintenance"
        base:expression "The system shall support periodic calibration of sensors and control devices to ensure environmental accuracy."
        stakeholder:isStatedBy stakeholders:SystemsEngineer
        base:category "L2"
        base:priority "Medium"
    ]
}
