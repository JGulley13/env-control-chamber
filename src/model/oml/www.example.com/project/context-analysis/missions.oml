@dc:title "Mission and Capabilities Description"
@dc:description "Description of missions and capabilities for the Environmental Control system."
description <http://www.example.com/project/context-analysis/missions#> as missions {
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <http://www.example.com/method/base#> as base
    uses <http://www.example.com/method/mission#> as mission
    uses <http://www.w3.org/2000/01/rdf-schema#> as rdfs

    @rdfs:label "Environmental Control"
    instance EnvironmentalControl : mission:Mission [
        base:description "Ensure optimal environmental conditions for 3D printing process."
    ]
}
