@dc:title "System Masses"
@dc:description "Mass estimates for the Environmental Control system physical parts."
description <http://www.example.com/project/system-analysis/masses#> as masses {
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <http://www.example.com/method/component#> as component
    extends <http://www.example.com/project/system-analysis/components#> as components
    uses <http://opencaesar.io/si/> as si

    ref instance components:EnvironmentalChamber : component:PhysicalPart [
        component:mass 68.0^^si:kg
    ]

    ref instance components:ChamberShell : component:PhysicalPart [
        component:mass 28.0^^si:kg
    ]

    ref instance components:PrintZone : component:PhysicalPart [
        component:mass 12.0^^si:kg
    ]

    ref instance components:AirHandlingUnit : component:PhysicalPart [
        component:mass 14.0^^si:kg
    ]

    ref instance components:IntakeFan : component:PhysicalPart [
        component:mass 3.0^^si:kg
    ]

    ref instance components:ExhaustFan : component:PhysicalPart [
        component:mass 2.5^^si:kg
    ]

    ref instance components:HeaterBank : component:PhysicalPart [
        component:mass 4.0^^si:kg
    ]

    ref instance components:Dehumidifier : component:PhysicalPart [
        component:mass 7.5^^si:kg
    ]

    ref instance components:HEPAFilter : component:PhysicalPart [
        component:mass 1.8^^si:kg
    ]

    ref instance components:CarbonFilter : component:PhysicalPart [
        component:mass 1.2^^si:kg
    ]

    ref instance components:TemperatureSensor : component:PhysicalPart [
        component:mass 0.35^^si:kg
    ]

    ref instance components:HumiditySensor : component:PhysicalPart [
        component:mass 0.25^^si:kg
    ]

    ref instance components:AirQualitySensor : component:PhysicalPart [
        component:mass 0.8^^si:kg
    ]

    ref instance components:Controller : component:PhysicalPart [
        component:mass 2.7^^si:kg
    ]

    ref instance components:UserInterface : component:PhysicalPart [
        component:mass 1.4^^si:kg
    ]

    ref instance components:SafetyInterlock : component:PhysicalPart [
        component:mass 1.1^^si:kg
    ]

    ref instance components:PowerSupply : component:PhysicalPart [
        component:mass 11.0^^si:kg
    ]
}
