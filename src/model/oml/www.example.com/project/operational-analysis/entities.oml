@dc:title "Entities and Capability Allocation Description"
@dc:description "Description of operational entities and allocation of capabilities for the Environmental Control Chamber."
description <http://www.example.com/project/operational-analysis/entities#> as entities {
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <http://www.example.com/method/base#> as base
    uses <http://www.example.com/method/entity#> as ent
    extends <http://www.example.com/project/context-analysis/stakeholders#> as stakeholders
    extends <http://www.example.com/project/operational-analysis/capabilities#> as capabilities

    instance ChamberControlSystem : ent:Entity [
        base:description "The control system that monitors and regulates chamber environment."
        ent:hasCapability capabilities:C1
        ent:hasCapability capabilities:C2
        ent:hasCapability capabilities:C3
        ent:hasCapability capabilities:C4
        ent:hasCapability capabilities:C5
        ent:hasCapability capabilities:C6
    ]

    instance ChamberMonitoringService : ent:Entity [
        base:description "External service that provides environmental telemetry and trend history."
        ent:hasCapability capabilities:C1
        ent:hasCapability capabilities:C2
        ent:hasCapability capabilities:C3
    ]

    instance EnvironmentalDAQ : ent:Entity [
        base:description "Data acquisition node for temperature, humidity, and air quality sensors."
        ent:hasCapability capabilities:C1
        ent:hasCapability capabilities:C2
        ent:hasCapability capabilities:C3
    ]

    instance Printer : ent:Entity [
        base:description "3D printer whose material quality depends on stable chamber conditions."
        ent:hasCapability capabilities:C1
        ent:hasCapability capabilities:C2
        ent:hasCapability capabilities:C3
    ]

    ref instance stakeholders:User : ent:Actor [
        base:description "Operates and monitors the chamber while a print is running."
        ent:hasCapability capabilities:C4
        ent:hasCapability capabilities:C6
    ]

    ref instance stakeholders:SystemsEngineer : ent:Actor [
        base:description "Maintains the chamber and validates its environmental control behavior."
        ent:hasCapability capabilities:C1
        ent:hasCapability capabilities:C5
    ]

    ref instance stakeholders:SafetyEngineer : ent:Actor [
        base:description "Ensures enclosure safety limits and alarm behavior are compliant."
        ent:hasCapability capabilities:C6
    ]

    ref instance stakeholders:ElectricalEngineer : ent:Actor [
        base:description "Verifies power and control integrity for the chamber systems."
        ent:hasCapability capabilities:C4
    ]
}
