@dc:title "Mission and Capabilities Description"
@dc:description "Description of missions and capabilities for the Environmental Control system."
description <http://www.example.com/project/operational-analysis/capabilities#> as capabilities {
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <http://www.example.com/method/base#> as base
    uses <http://www.example.com/method/mission#> as mission
    extends <http://www.example.com/project/context-analysis/objectives#> as objectives

    instance C1 : mission:Capability [
        base:description "Enable monitoring of chamber temperature."
        mission:isRequiredBy objectives:O1
    ]

    instance C2 : mission:Capability [
        base:description "Enable monitoring of chamber humidity."
        mission:isRequiredBy objectives:O2
    ]

    instance C3 : mission:Capability [
        base:description "Enable monitoring of chamber air quality."
        mission:isRequiredBy objectives:O3
    ]

    instance C4 : mission:Capability [
        base:description "Enable control of chamber temperature."
        mission:isRequiredBy objectives:O1
    ]

    instance C5 : mission:Capability [
        base:description "Enable control of chamber humidity."
        mission:isRequiredBy objectives:O2
    ]

    instance C6 : mission:Capability [
        base:description "Enable control of chamber air quality."
        mission:isRequiredBy objectives:O3
    ]

    instance C7 : mission:Capability [
        base:description "Ensure system is lightweight and portable."
        mission:isRequiredBy objectives:O4
    ]
}
